+import { createHash } from 'node:crypto';
+import { sql } from 'drizzle-orm';
+import { tryLockNativeWorkspaceFinalization } from './native-workspace-finalization-ownership.js';
+
+const refused = reason => ({ kind: 'not_replayed', reason });
+const uuid = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i;
+const fields = ['companyId', 'issueId', 'workspaceId', 'runId', 'failedOperationId'];
+const digest = bytes => createHash('sha256').update(bytes).digest('hex');
+
+function matchesSealedCopy(snapshot, binding) {
+    if (!snapshot || ![...fields, 'bindingRevision'].every(key => snapshot.binding?.[key] === binding[key])) return false;
+    const { manifest, original, preserved } = snapshot;
+    if (!(original instanceof Map) || !(preserved instanceof Map) || !Array.isArray(manifest)
+        || !manifest.length || manifest.length !== original.size || manifest.length !== preserved.size) return false;
+    const seen = new Set();
+    return manifest.every(entry => {
+        if (!entry || typeof entry.name !== 'string' || !entry.name || seen.has(entry.name)) return false;
+        seen.add(entry.name);
+        return [original, preserved].every(tree => {
+            const bytes = tree.get(entry.name);
+            return Buffer.isBuffer(bytes) && bytes.length === entry.size && digest(bytes) === entry.sha256;
+        });
+    });
+}
+
+export async function preflightHistoricalWorkspaceFinalize(services, binding) {
+    if (services.enableHistoricalFinalizePreflight !== true) return refused('disabled');
+    if (!binding || !fields.every(key => typeof binding[key] === 'string' && uuid.test(binding[key]))
+        || !Number.isSafeInteger(binding.bindingRevision) || binding.bindingRevision < 1) return refused('invalid_binding');
+    const { companyId, issueId, workspaceId, runId, failedOperationId, bindingRevision } = binding;
+    return services.db.transaction(async tx => {
+        if (!await tryLockNativeWorkspaceFinalization(tx, { companyId, runId })) return refused('owner_busy');
+        const [row] = await tx.execute(sql`
+            select r.runner_profile_json->'nativeWorkspaceFinalizationOwner' as owner,
+                   f.lease_owner, o.started_at, o.finished_at
+              from issues i
+              join execution_workspaces w on w.company_id=i.company_id and w.id=i.execution_workspace_id
+              join heartbeat_runs r on r.company_id=i.company_id and coalesce(r.native_issue_id,r.issue_id)=i.id
+                   and (r.issue_id is null or r.issue_id=i.id)
+              join workspace_operations o on o.company_id=i.company_id and o.issue_id=i.id
+                   and o.execution_workspace_id=w.id and o.heartbeat_run_id=r.id
+              left join native_run_finalizations f on f.company_id=i.company_id and f.run_id=r.id
+             where i.company_id=${companyId}::uuid and i.id=${issueId}::uuid and w.id=${workspaceId}::uuid
+               and r.id=${runId}::uuid and o.id=${failedOperationId}::uuid
+               and i.workspace_binding_revision=${bindingRevision} and i.status='done'
+               and i.execution_run_id is null and i.checkout_run_id is null
+               and r.status in ('succeeded','failed','cancelled','interrupted','timed_out')
+               and r.runtime_mode='native' and (f.run_id is null or f.issue_id=i.id)
+               and r.runner_profile_json#>>'{nativeExecutionInput,binding,executionWorkspaceId}'=w.id::text
+               and o.metadata->>'adapterType'='paperclip_runner' and o.metadata->>'executionTargetKind'='local'
+               and o.phase='workspace_finalize' and o.status='failed' and o.finished_at is not null
+               and not exists (select 1 from workspace_operations other
+                    where other.company_id=i.company_id and other.execution_workspace_id=w.id
+                      and other.id<>o.id and (other.started_at>=o.started_at or other.status in ('pending','running')))`);
+        if (!row) return refused('stale_or_unbound');
+        if (row.owner != null || row.lease_owner != null) return refused('stop_unproved');
+        const snapshot = await services.readSealedSnapshot?.({ companyId, issueId, workspaceId, runId, failedOperationId, bindingRevision });
+        if (!matchesSealedCopy(snapshot, binding)) return refused('preservation_unproved');
+        return refused('original_runner_finalize_unavailable');
+    });
